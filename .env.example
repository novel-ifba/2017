# Copie este arquivo para .env e preencha com os valores reais.
# No Coolify, configure estas mesmas chaves na aba "Environment Variables"
# do serviço (o app le via getenv(), nao ha carregamento automatico de .env).

# Ambiente da aplicacao CodeIgniter: development | testing | production
CI_ENV=production

# URL publica da aplicacao (sem barra no final)
APP_BASE_URL=https://seu-dominio.com

# 0=off 1=erros 2=debug 3=info 4=tudo (deixe baixo em producao)
APP_LOG_THRESHOLD=1

# Chave usada pela CI_Encryption/CI_Encrypt. Gere com: openssl rand -hex 32
APP_ENCRYPTION_KEY=

# IP(s) do proxy reverso do Coolify, para o CI confiar em X-Forwarded-*
# (necessario para is_https()/IP do visitante funcionarem atras do proxy)
PROXY_IPS=

# Cookies de sessao/CSRF so enviados via HTTPS. Deixe true em producao.
COOKIE_SECURE=true
COOKIE_DOMAIN=

# Driver de sessao do CodeIgniter: files | database
# 'database' evita perda de sessao quando ha mais de uma replica do container
# (o driver 'files' grava em /tmp local de cada replica, sem storage compartilhado).
SESSION_DRIVER=database

# Driver 'files': caminho de diretorio dentro do container.
# Driver 'database' (atual): nome da tabela (ver session_table.sql na raiz do repo).
SESSION_SAVE_PATH=ci_sessions

# Conexao com o MySQL
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=novel
DB_USERNAME=root
DB_PASSWORD=troque-esta-senha
# TRUE exibe erros de SQL na tela - use so em development
DB_DEBUG=false

# SMTP usado no envio de e-mail de "esqueceu a senha" (Principal::recuperarSenha)
SMTP_PROTOCOL=smtp
SMTP_HOST=ssl://smtp.gmail.com
SMTP_PORT=465
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app
