FROM php:7.4-apache

RUN apt-get update \
	&& apt-get install -y --no-install-recommends unzip \
	&& docker-php-ext-install mysqli \
	&& a2enmod rewrite \
	&& rm -rf /var/lib/apt/lists/*

WORKDIR /var/www/html

COPY . /var/www/html

RUN mkdir -p /tmp/ci_sessions \
	&& chown -R www-data:www-data /var/www/html/application/cache /var/www/html/application/logs /tmp/ci_sessions

ENV CI_ENV=production
ENV SESSION_SAVE_PATH=/tmp/ci_sessions

EXPOSE 80
